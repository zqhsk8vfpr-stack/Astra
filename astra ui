        callback = function(val) getgenv().CSyncVisualize = val end,
    })
    csync:toggle({
        name = "legit anti aim",
        flag = "rage_antiaim_legit",
        default = false,
        callback = function(val) getgenv().LegitAntiAim = val end,
    })
    csync:toggle({
        name = "anti ground shot",
        flag = "legit_antigroundshot",
        default = false,
        tooltip = "prevent shooting at ground",
        callback = function(val) getgenv().AntiGroundShot = val end,
    })

    -- Lock Button section (right side, below Csync)
    local lockSection = rage:section({ name = "Lock Button", side = "right" })
    lockSection:toggle({
        name = "Enable Floating Button",
        flag = "lock_button_enabled",
        default = false,
        tooltip = "Show/hide the floating lock button",
        callback = function(val)
            getgenv().LockButtonEnabled = val
            if val then
                if not lockGui then
                    createLockButton()
                end
                setLockButtonVisible(true)
            else
                setLockButtonVisible(false)
            end
        end
    })
    lockSection:toggle({
        name = "Auto Shoot",
        flag = "auto_shoot",
        default = false,
        tooltip = "Automatically fire your weapon when locked onto a target",
        callback = function(val)
            getgenv().AutoShoot = val
        end
    })
    lockSection:toggle({
        name = "Show Lock Notifications",
        flag = "lock_notifications",
        default = true,
        tooltip = "Show notifications when locking/unlocking",
        callback = function(val)
            getgenv().LockNotifications = val
        end
    })
    -- Initialize button if toggle was previously enabled
    if getgenv().LockButtonEnabled then
        createLockButton()
        setLockButtonVisible(true)
    end
    if getgenv().LockNotifications == nil then
        getgenv().LockNotifications = true
    end
    if getgenv().AutoShoot == nil then
        getgenv().AutoShoot = false
    end
end

