-- Auto shoot cooldown
local lastAutoShootTime = 0
local autoShootCooldown = 0.15

-- Helper functions
local function getCharacter(plr) return plr.Character end
local function IsKnocked(char)
    if not char then return true end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and root.Anchored then return true end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") and not v.Enabled then return true end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health <= 0
end

local function getValidEnemies()
    local enemies = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if getgenv().FriendCheck and plr:IsFriendsWith(LocalPlayer.UserId) then continue end
        local char = getCharacter(plr)
        if not char then continue end
        if getgenv().KnockCheck and IsKnocked(char) then continue end
        if getgenv().ForcefieldCheck and char:FindFirstChildOfClass("ForceField") then continue end
        if not char:FindFirstChild("HumanoidRootPart") then continue end
        table.insert(enemies, plr)
    end
    return enemies
end

local function choosePlayer(playerList)
    if #playerList == 0 then return nil end
    local bestDist, best = math.huge, nil
    for _, plr in ipairs(playerList) do
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local dist = (root.Position - Camera.CFrame.Position).Magnitude
            if dist < bestDist then bestDist = dist; best = plr end
        end
    end
    return best
end

local function updateLockedTarget()
    if not lockActive then
        lockedTarget = nil
        getgenv().LockedTarget = nil
        return
    end
    if lockedTarget and lockedTarget.Character and not IsKnocked(lockedTarget.Character) then
        return
    end
    local enemies = getValidEnemies()
    local newTarget = choosePlayer(enemies)
    if newTarget then
        lockedTarget = newTarget
        getgenv().LockedTarget = newTarget
    else
        lockActive = false
        getgenv().LockActive = false
        lockedTarget = nil
        getgenv().LockedTarget = nil
        if lockButton then
            lockButton.Image = "rbxassetid://6031098676" -- shield outline (unlocked)
            lockButton.ImageColor3 = Color3.fromRGB(200, 200, 255)
            lockButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        end
    end
end

local function autoShoot()
    if not getgenv().AutoShoot then return end
    if not lockActive or not lockedTarget then return end

    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return end

    local now = tick()
    if now - lastAutoShootTime < autoShootCooldown then return end
    lastAutoShootTime = now

    local success = pcall(function()
        tool:Activate()
    end)
    if not success then
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("MAINEVENT")
        if remote and remote:IsA("RemoteEvent") then
            local targetPos = lockedTarget.Character and lockedTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetPos then
                remote:FireServer("MOUSE", targetPos.Position)
            end
        end
    end
end

-- Create the floating button with shield icons
local function createLockButton()
    if lockGui then
        lockGui:Destroy()
        lockGui = nil
        lockButton = nil
    end

    lockGui = Instance.new("ScreenGui")
    lockGui.Name = "LockButtonGui"
    lockGui.Parent = CoreGui
    lockGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    lockGui.ResetOnSpawn = false

    lockButton = Instance.new("ImageButton")
    lockButton.Name = "LockButton"
    lockButton.Parent = lockGui
    lockButton.Size = UDim2.new(0, 60, 0, 60)
    lockButton.Position = UDim2.new(0.85, 0, 0.5, 0)
    lockButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    lockButton.BackgroundTransparency = 0.1
    lockButton.Image = "rbxassetid://6031098676" -- shield outline (unlocked)
    lockButton.ImageColor3 = Color3.fromRGB(200, 200, 255)
    lockButton.Draggable = true

    local corner = Instance.new("UICorner", lockButton)
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", lockButton)
    stroke.Color = Color3.fromRGB(100, 100, 200)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3

    lockButton.MouseButton1Click:Connect(function()
        if not getgenv().LockButtonEnabled then return end
        lockActive = not lockActive
        getgenv().LockActive = lockActive
        if lockActive then
            local enemies = getValidEnemies()
            local target = choosePlayer(enemies)
            if target then
                lockedTarget = target
                getgenv().LockedTarget = target
                lockButton.Image = "rbxassetid://6031098676" -- filled shield (locked)
                lockButton.ImageColor3 = Color3.fromRGB(255, 200, 100)
                lockButton.BackgroundColor3 = Color3.fromRGB(50, 35, 20)
                stroke.Color = Color3.fromRGB(255, 200, 100)
                stroke.Transparency = 0
                if getgenv().LockNotifications then
                    library:notification({ text = "Locked onto " .. target.DisplayName, duration = 2 })
                end
            else
                lockActive = false
                getgenv().LockActive = false
                lockedTarget = nil
                getgenv().LockedTarget = nil
                lockButton.Image = "rbxassetid://6031098676"
                lockButton.ImageColor3 = Color3.fromRGB(200, 200, 255)
                lockButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                stroke.Color = Color3.fromRGB(100, 100, 200)
                stroke.Transparency = 0.3
                if getgenv().LockNotifications then
                    library:notification({ text = "No valid target found", duration = 2 })
                end
            end
        else
            lockedTarget = nil
            getgenv().LockedTarget = nil
            lockButton.Image = "rbxassetid://6031098676"
            lockButton.ImageColor3 = Color3.fromRGB(200, 200, 255)
            lockButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            stroke.Color = Color3.fromRGB(100, 100, 200)
            stroke.Transparency = 0.3
            if getgenv().LockNotifications then
                library:notification({ text = "Unlocked", duration = 1 })
            end
        end
    end)

    return lockButton
end

local function setLockButtonVisible(visible)
    if lockGui then
        lockGui.Enabled = visible
    end
end

-- Continuous validation loop
RunService.RenderStepped:Connect(function()
    if getgenv().LockButtonEnabled then
        updateLockedTarget()
    end
end)

-- Auto shoot loop
RunService.Heartbeat:Connect(function()
    autoShoot()
end)

